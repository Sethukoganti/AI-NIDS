# ============================================================================
# AI-NIDS - environment template.  Copy to .env and adjust.  Never commit .env.
# ============================================================================

# --- application ------------------------------------------------------------
APP_NAME=AI-NIDS
APP_VERSION=1.0.0
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO

# --- database ---------------------------------------------------------------
# Local development (zero setup):
DATABASE_URL=sqlite:///./data/ainids.db
# PostgreSQL (docker-compose provides this service):
# DATABASE_URL=postgresql+psycopg2://ainids:ainids@localhost:5432/ainids
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- security ---------------------------------------------------------------
# Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-env-dev-only-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
PASSWORD_MIN_LENGTH=8

# --- machine learning -------------------------------------------------------
MODEL_PATH=backend/app/ml/random_forest_model.joblib
FEATURE_COLUMNS_PATH=backend/app/ml/feature_columns.json
MODEL_METADATA_PATH=backend/app/ml/model_metadata.json
EVALUATION_PATH=backend/app/ml/evaluation.json
FEATURE_IMPORTANCE_PATH=backend/app/ml/feature_importance.json
LABEL_CODES_PATH=backend/app/ml/label_codes.json
LABEL_MAPPING_PATH=backend/app/ml/label_mapping.json
PREPROCESSING_CONFIG_PATH=backend/app/ml/preprocessing_config.json
DATASET_STATS_PATH=backend/app/ml/dataset_stats.json

# --- uploads / jobs ---------------------------------------------------------
MAX_UPLOAD_SIZE=26214400         # bytes (25 MB)
MAX_ROWS_PER_JOB=200000
SYNC_ANALYSIS_ROW_LIMIT=2000     # analyse inline up to this many rows
STORE_PREDICTIONS_LIMIT=50000
JOB_WORKERS=2

# --- rate limiting ----------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_PREDICT=30/minute
RATE_LIMIT_UPLOAD=20/minute
RATE_LIMIT_DEFAULT=300/minute

# --- CORS -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
CORS_ALLOW_ORIGIN_REGEX=https://([a-z0-9-]+\.)?e2b\.app|http://(localhost|127\.0\.0\.1)(:\d+)?

# --- optional AI explanation provider --------------------------------------
# none  -> local deterministic explanation engine (no key required)
# openai|groq|together|... -> any OpenAI-compatible /chat/completions endpoint
# ollama -> local Ollama server
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=30
AI_MAX_TOKENS=700

# --- demo data --------------------------------------------------------------
SEED_DEMO_DATA=true
DEMO_USER_EMAIL=analyst@ainids.dev
DEMO_USER_PASSWORD=Analyst@123
DEMO_ADMIN_EMAIL=admin@ainids.dev
DEMO_ADMIN_PASSWORD=Admin@1234
